#!/bin/sh
#
# S99thermal — автозапуск + watchdog тепловізійного H.265-sender'а на RV1106.
#
# Мета: увімкнув плату → sender уже слухає :5000; на землі (BPI) лише приймач.
# Жодних команд на плату слати не треба, і рідкісний блип USB-камери
# (спонтанна переенумерація) залічується сам.
#
# Що робить:
#   1) зупиняє штатний камерний застосунок rkipc (RkLunch-stop.sh) — звільняє
#      камеру й апаратний енкодер;
#   2) вимикає USB-autosuspend (часта причина спонтанної переенумерації);
#   3) чекає USB-камеру (YUYV-нода, номер «плаває») і піднімає rv1106_sender;
#   4) WATCHDOG: якщо камера переенумерувалась (змінився devnum) або sender
#      впав — гасить старий процес і піднімає новий на свіжій ноді.
#
# Логи: /tmp/thermal.log (sender), /tmp/thermal_watchdog.log (наглядач).
# Керування: /etc/init.d/S99thermal {start|stop|restart|status}

BIN=/root/rv1106_sender
LOG=/tmp/thermal.log
WLOG=/tmp/thermal_watchdog.log
PIDFILE=/tmp/thermal_sup.pid
PORT=5000
# 25 к/с: удвічі менший USB-трафік, ніж 60 — прибирає EOVERFLOW (-75) і
# «disabled by hub (EMI?)», що валили хаб під тривалим стрімом. Тепловізору
# більше й не треба. За потреби зменшити ще (15), якщо камера/USB марджинальні.
FPS=25
export LD_LIBRARY_PATH=/oem/usr/lib

# Режим виходу: tcp (rv1106_sender :5000, для прямого тракту на BPI) або
# rtsp (rv1106_rtsp :554/live/0, для Sine.video Beam). Перемикач — файл
# /root/thermal_mode; за замовчуванням tcp.
MODE=$(cat /root/thermal_mode 2>/dev/null || echo tcp)

# devnum USB-камери Seek (VID 3474); змінюється при кожній переенумерації
cam_devnum() {
    for d in /sys/bus/usb/devices/*; do
        if [ "$(cat "$d/idVendor" 2>/dev/null)" = "3474" ]; then
            cat "$d/devnum" 2>/dev/null; return 0
        fi
    done
    return 1
}

# нода USB-камери Seek: саме USB (Bus info … usb) + YUYV, щоб не вхопити
# платформну ISP-ноду (rkcif/rkisp теж бувають YUYV).
cam_node() {
    for v in /dev/video*; do
        v4l2-ctl -d "$v" --all 2>/dev/null | grep -q "Bus info.*usb" || continue
        if v4l2-ctl -d "$v" --list-formats 2>/dev/null | grep -q YUYV; then
            echo "$v"; return 0
        fi
    done
    return 1
}

disable_autosuspend() {
    for f in /sys/bus/usb/devices/*/power/control; do echo on > "$f" 2>/dev/null; done
    for f in /sys/bus/usb/devices/*/power/autosuspend_delay_ms; do echo -1 > "$f" 2>/dev/null; done
}

launch_sender() {
    CAM=$(cam_node) || { echo "$(date) launch: камери нема" >> "$WLOG"; return 1; }
    if [ "$MODE" = "rtsp" ]; then
        echo "=== $(date) === RTSP старт на $CAM (:554/live/0, ${FPS}fps)" >> "$LOG"
        /root/rv1106_rtsp --device "$CAM" --port 554 --path /live/0 --fps "$FPS" >> "$LOG" 2>&1 &
    else
        echo "=== $(date) === TCP старт на $CAM (:$PORT, ${FPS}fps)" >> "$LOG"
        "$BIN" --device "$CAM" --port "$PORT" --fps "$FPS" >> "$LOG" 2>&1 &
    fi
    SENDER_PID=$!
    echo "$(date) [$MODE] sender pid $SENDER_PID на $CAM" >> "$WLOG"
    return 0
}

wait_cam() {
    i=0
    while [ $i -lt 30 ]; do
        cam_node >/dev/null 2>&1 && return 0
        i=$((i + 1)); sleep 1
    done
    return 1
}

supervise() {
    [ -x /oem/usr/bin/RkLunch-stop.sh ] && /oem/usr/bin/RkLunch-stop.sh >/dev/null 2>&1
    killall -9 rkipc ispserver rv1106_sender rv1106_rtsp 2>/dev/null
    sleep 2
    disable_autosuspend
    wait_cam || echo "$(date) камера не зʼявилась за 30с" >> "$WLOG"
    launch_sender
    LAST=$(cam_devnum)

    while true; do
        sleep 5
        NOW=$(cam_devnum)
        # 1) камера переенумерувалась → нода/fd застаріли → перезапуск
        if [ -n "$NOW" ] && [ -n "$LAST" ] && [ "$NOW" != "$LAST" ]; then
            echo "$(date) камера переенумерувалась ($LAST->$NOW) → рестарт sender" >> "$WLOG"
            kill -9 "$SENDER_PID" 2>/dev/null; killall -9 rv1106_sender rv1106_rtsp 2>/dev/null
            sleep 1; disable_autosuspend; launch_sender; LAST=$(cam_devnum); continue
        fi
        # 2) sender впав → перезапуск
        if ! kill -0 "$SENDER_PID" 2>/dev/null; then
            echo "$(date) sender зник → рестарт" >> "$WLOG"
            sleep 1; launch_sender; LAST=$(cam_devnum); continue
        fi
        # 3) камера повністю зникла → чекаємо, скидаємо, перезапускаємо
        if [ -z "$NOW" ]; then
            echo "$(date) камера зникла → чекаю появи" >> "$WLOG"
            kill -9 "$SENDER_PID" 2>/dev/null; killall -9 rv1106_sender rv1106_rtsp 2>/dev/null
            wait_cam
            sleep 1; disable_autosuspend; launch_sender; LAST=$(cam_devnum)
        fi
    done
}

start() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "supervisor вже працює (pid $(cat "$PIDFILE"))"; return 0
    fi
    supervise >> "$WLOG" 2>&1 &
    echo $! > "$PIDFILE"
    echo "supervisor запущено (pid $(cat "$PIDFILE"))"
}

stop() {
    [ -f "$PIDFILE" ] && kill -9 "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
    killall -9 rv1106_sender rv1106_rtsp 2>/dev/null
    echo "зупинено"
}

status() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "supervisor ПРАЦЮЄ (pid $(cat "$PIDFILE"))"
    else
        echo "supervisor не запущений"
    fi
    echo "режим: $MODE"
    if pidof rv1106_sender >/dev/null 2>&1; then
        echo "rv1106_sender (TCP) ПРАЦЮЄ (pid $(pidof rv1106_sender)), камера devnum=$(cam_devnum)"
    elif pidof rv1106_rtsp >/dev/null 2>&1; then
        echo "rv1106_rtsp (RTSP) ПРАЦЮЄ (pid $(pidof rv1106_rtsp)), камера devnum=$(cam_devnum)"
    else
        echo "sender не запущений"
    fi
    echo "--- $LOG ---"; tail -n 6 "$LOG" 2>/dev/null
    echo "--- $WLOG ---"; tail -n 6 "$WLOG" 2>/dev/null
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)  status ;;
    *) echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
exit 0
